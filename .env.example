# FreightBrokerCMR Backend — Production Environment Variables
#
# Copy this file to .env and populate real values before deploying to production.
# Never commit .env (it contains secrets). This .env.example is safe to commit.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.freightbrokercmr.example.com

# ------------------------------------------------------------
# JWT (REQUIRED in production — must NOT be the demo default)
# Must be >= 32 characters and NOT equal to DEV_FALLBACK_SECRET.
# Generate with: openssl rand -base64 48
# ------------------------------------------------------------
JWT_SECRET=changeme-this-must-be-at-least-32-chars-and-random

# ------------------------------------------------------------
# MongoDB (REQUIRED in production)
# Use a dedicated production database with authentication enabled.
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/freightbrokercmr?retryWrites=true&w=majority

# ------------------------------------------------------------
# CORS (REQUIRED in production — restrict to your frontend origin)
# Comma-separated list. Do not use '*' in production.
# ------------------------------------------------------------
CORS_ORIGIN=https://freightbrokercmr.example.com

# ------------------------------------------------------------
# Rate limiting (optional tuning)
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20

# ------------------------------------------------------------
# Feature flags (optional)
# ------------------------------------------------------------
DEMO_MODE_ENABLED=false
