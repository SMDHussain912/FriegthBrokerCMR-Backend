# Freight Broker CRM Backend Configuration
PORT=5000
NODE_ENV=production

# MongoDB connection string (MongoDB Atlas recommended for Render)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/freight_crm?retryWrites=true&w=majority

# JWT signing secret — MUST be at least 32 chars, NOT the demo default
JWT_SECRET=<generate-a-32-plus-char-secret>

# Allowed frontend origins for CORS (comma-separated, no trailing slashes)
# Add your Vercel frontend URL here, e.g. https://freightbroker.vercel.app
CORS_ORIGIN=https://freightbroker.vercel.app,http://localhost:3000
