# Freight Broker CRM Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Use a dedicated database for tests, e.g.:
#   MONGODB_URI=mongodb://localhost:27017/freight_crm_assignment_test
MONGODB_URI=mongodb://localhost:27017/freight_crm

# JWT signing secret.
# DEVELOPMENT ONLY: the value below is a published demo secret and is unsafe
# for any shared or production environment.
# PRODUCTION REQUIREMENTS (enforced at startup by middleware/auth.js):
#   - JWT_SECRET must be set
#   - it must NOT equal the demo secret below
#   - it must be at least 32 characters long
# The server refuses to start / authenticate otherwise.
JWT_SECRET=development_jwt_secret_freight_broker_crm_2026
